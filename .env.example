# ==========================================
# MedVance AI - Environment Configuration
# ==========================================

# Server
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/medvance_ai

# Authentication & Security
JWT_SECRET=medvance_super_secret_jwt_key_2026_production
JWT_REFRESH_SECRET=medvance_refresh_secret_token_key_2026
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173

# Storage (local | s3 | cloudinary)
STORAGE_TYPE=local
UPLOAD_DIR=./uploads
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# AI Provider (mock-fallback | openai | gemini)
AI_PROVIDER=mock-fallback
AI_API_KEY=

# Email (smtp | resend | sendgrid)
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=MedVance AI <noreply@medvance.ai>

# Payments (stripe | razorpay)
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
